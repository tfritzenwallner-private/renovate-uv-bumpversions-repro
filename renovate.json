{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "bumpVersions": [
        {
          "name": "Bump project.version",
          "filePatterns": [
            "pyproject.toml"
          ],
          "matchStrings": [
            "(?m)^version = \"(?<version>[^\"]+)\""
          ],
          "bumpType": "patch"
        },
        {
          "name": "Bump the uv.lock root package",
          "filePatterns": [
            "uv.lock"
          ],
          "matchStrings": [
            "(?m)^version = \"(?<version>[^\"]+)\"\\nsource = \\{ (?:editable|virtual) = \"\\.\" \\}"
          ],
          "bumpType": "patch"
        }
      ]
    }
  ]
}
